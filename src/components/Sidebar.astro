---
// Sidebar derecho con próximos partidos, top jugadores, y newsletter
---

<aside class="sidebar">
  <!-- Próximos partidos -->
  <div class="widget">
    <h3>Próximos partidos</h3>
    <div id="upcomingGames" class="upcoming-list">
      <div class="widget-loading">
        <span class="skeleton-line"></span>
        <span class="skeleton-line"></span>
        <span class="skeleton-line"></span>
      </div>
    </div>
  </div>

  <!-- Top jugadores temporada 2025-26 (datos reales) -->
  <div class="widget">
    <h3>Top anotadores · 2025-26</h3>
    <div class="player-list">
      <div class="player-item">
        <span class="player-rank">1</span>
        <div class="player-av">LD</div>
        <div class="player-info">
          <div class="player-name">Luka Dončić</div>
          <div class="player-team">LA Lakers</div>
        </div>
        <div class="player-stat">
          <span class="stat-val">33.5</span>
          <span class="stat-label">PPP</span>
        </div>
      </div>
      <div class="player-item">
        <span class="player-rank">2</span>
        <div class="player-av">SG</div>
        <div class="player-info">
          <div class="player-name">Shai Gilgeous-Alexander</div>
          <div class="player-team">OKC Thunder</div>
        </div>
        <div class="player-stat">
          <span class="stat-val">32.8</span>
          <span class="stat-label">PPP</span>
        </div>
      </div>
      <div class="player-item">
        <span class="player-rank">3</span>
        <div class="player-av">NJ</div>
        <div class="player-info">
          <div class="player-name">Nikola Jokić</div>
          <div class="player-team">Denver Nuggets</div>
        </div>
        <div class="player-stat">
          <span class="stat-val">29.6</span>
          <span class="stat-label">PPP</span>
        </div>
      </div>
      <div class="player-item">
        <span class="player-rank">4</span>
        <div class="player-av">VW</div>
        <div class="player-info">
          <div class="player-name">Victor Wembanyama</div>
          <div class="player-team">San Antonio Spurs</div>
        </div>
        <div class="player-stat">
          <span class="stat-val">26.4</span>
          <span class="stat-label">PPP</span>
        </div>
      </div>
      <div class="player-item">
        <span class="player-rank">5</span>
        <div class="player-av">CC</div>
        <div class="player-info">
          <div class="player-name">Cade Cunningham</div>
          <div class="player-team">Detroit Pistons</div>
        </div>
        <div class="player-stat">
          <span class="stat-val">26.1</span>
          <span class="stat-label">PPP</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Newsletter -->
  <div class="widget newsletter-widget">
    <h3>Newsletter</h3>
    <p class="newsletter-desc">Lo mejor de la NBA en tu correo cada mañana.</p>
    <input type="email" placeholder="tu@email.com" class="newsletter-input" />
    <button class="newsletter-btn">Suscribirme</button>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .widget {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .widget h3 {
    color: var(--color-white);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-accent);
  }

  .upcoming-list { display: flex; flex-direction: column; }
  .widget-loading { display: flex; flex-direction: column; gap: 8px; }
  .skeleton-line {
    height: 40px;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-sm);
    animation: pulse 1.5s infinite;
  }
  .upcoming-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 12px;
  }
  .upcoming-item:last-child { border-bottom: none; }
  .upcoming-teams { color: var(--color-white); font-weight: 600; }
  .upcoming-when { color: var(--color-text-dim); font-size: 11px; }
  .upcoming-empty {
    color: var(--color-text-dim);
    font-size: 12px;
    padding: 12px 0;
    font-style: italic;
  }

  .player-list { display: flex; flex-direction: column; }
  .player-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .player-item:last-child { border-bottom: none; }
  .player-rank {
    color: var(--color-accent);
    font-weight: 800;
    font-size: 16px;
    width: 18px;
  }
  .player-av {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(230, 57, 70, 0.15);
    border: 1px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 700;
  }
  .player-info { flex: 1; min-width: 0; }
  .player-name { color: var(--color-white); font-size: 13px; font-weight: 600; }
  .player-team { color: var(--color-text-dim); font-size: 11px; }
  .player-stat { text-align: right; }
  .stat-val { color: var(--color-white); font-size: 16px; font-weight: 700; display: block; line-height: 1; }
  .stat-label { color: var(--color-text-dim); font-size: 10px; }

  .newsletter-widget {
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.15), var(--color-bg-card));
    border-color: rgba(230, 57, 70, 0.4);
  }
  .newsletter-desc {
    color: var(--color-text-muted);
    font-size: 12px;
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .newsletter-input {
    width: 100%;
    background: var(--color-black);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    color: var(--color-white);
    font-size: 13px;
    margin-bottom: 8px;
    font-family: inherit;
  }
  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .newsletter-btn {
    width: 100%;
    background: var(--color-accent);
    color: white;
    padding: 9px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .newsletter-btn:hover { background: var(--color-accent-hover); }
</style>

<script>
  async function loadUpcoming() {
    const container = document.getElementById('upcomingGames');
    if (!container) return;

    try {
      const dates = [];
      for (let i = 0; i < 4; i++) {
        const d = new Date();
        d.setDate(d.getDate() + i);
        dates.push(d.toISOString().split('T')[0]);
      }
      const params = new URLSearchParams();
      dates.forEach(d => params.append('dates[]', d));
      params.set('per_page', '8');

      const res = await fetch(`https://api.balldontlie.io/v1/games?${params}`);
      if (!res.ok) throw new Error('API');
      const data = await res.json();
      const games = (data.data || []).filter(g => g.status !== 'Final').slice(0, 5);

      if (games.length === 0) {
        renderEmpty(container);
        return;
      }

      container.innerHTML = games.map(g => {
        const date = new Date(g.date);
        const when = date.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        return `
          <div class="upcoming-item">
            <div>
              <div class="upcoming-teams">${g.visitor_team.abbreviation} @ ${g.home_team.abbreviation}</div>
              <div class="upcoming-when">${when}</div>
            </div>
            <i class="ti ti-chevron-right" style="color: var(--color-text-dim)"></i>
          </div>
        `;
      }).join('');
    } catch (e) {
      renderEmpty(container);
    }
  }

  function renderEmpty(container) {
    container.innerHTML = `<div class="upcoming-empty">No hay partidos programados ahora mismo</div>`;
  }

  loadUpcoming();
</script>
