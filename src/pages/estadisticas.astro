---

<BaseLayout title="Estadísticas NBA · 24 Segundos">
  <div class="container stats-page">
    <div class="page-header">
      <h1>Estadísticas</h1>
      <p>Líderes individuales · Temporada 2025-26</p>
    </div>

    <div class="stats-tabs">
      <button class="stat-tab active" data-cat="pts">Puntos</button>
      <button class="stat-tab" data-cat="reb">Rebotes</button>
      <button class="stat-tab" data-cat="ast">Asistencias</button>
      <button class="stat-tab" data-cat="blk">Tapones</button>
    </div>

    <div class="stats-grid">
      <div class="leaders-card active" id="pts">
        <div class="leaders-header">
          <h2>Líderes en puntos</h2>
          <span class="unit">PTS por partido</span>
        </div>
        <table class="leaders-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Jugador</th>
              <th>Equipo</th>
              <th>Pos.</th>
              <th class="num">PPP</th>
            </tr>
          </thead>
          <tbody>
            {ptsLeaders.map(p => (
              <tr>
                <td class="rank">{p.rank}</td>
                <td class="player">{p.name}</td>
                <td>{p.team}</td>
                <td class="pos">{p.pos}</td>
                <td class="num val">{p.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="leaders-card" id="reb">
        <div class="leaders-header">
          <h2>Líderes en rebotes</h2>
          <span class="unit">REB por partido</span>
        </div>
        <table class="leaders-table">
          <thead>
            <tr><th>#</th><th>Jugador</th><th>Equipo</th><th>Pos.</th><th class="num">RPP</th></tr>
          </thead>
          <tbody>
            {rebLeaders.map(p => (
              <tr>
                <td class="rank">{p.rank}</td>
                <td class="player">{p.name}</td>
                <td>{p.team}</td>
                <td class="pos">{p.pos}</td>
                <td class="num val">{p.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="leaders-card" id="ast">
        <div class="leaders-header">
          <h2>Líderes en asistencias</h2>
          <span class="unit">AST por partido</span>
        </div>
        <table class="leaders-table">
          <thead>
            <tr><th>#</th><th>Jugador</th><th>Equipo</th><th>Pos.</th><th class="num">APP</th></tr>
          </thead>
          <tbody>
            {astLeaders.map(p => (
              <tr>
                <td class="rank">{p.rank}</td>
                <td class="player">{p.name}</td>
                <td>{p.team}</td>
                <td class="pos">{p.pos}</td>
                <td class="num val">{p.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="leaders-card" id="blk">
        <div class="leaders-header">
          <h2>Líderes en tapones</h2>
          <span class="unit">BLK por partido</span>
        </div>
        <table class="leaders-table">
          <thead>
            <tr><th>#</th><th>Jugador</th><th>Equipo</th><th>Pos.</th><th class="num">TPP</th></tr>
          </thead>
          <tbody>
            {blkLeaders.map(p => (
              <tr>
                <td class="rank">{p.rank}</td>
                <td class="player">{p.name}</td>
                <td>{p.team}</td>
                <td class="pos">{p.pos}</td>
                <td class="num val">{p.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="info-note">
      <i class="ti ti-info-circle"></i>
      <span>Datos finales de la temporada regular 2025-26. Fuente: NBA.com / Wikipedia.</span>
    </div>
  </div>
</BaseLayout>

<style>
  .stats-page { padding: 32px 0; }
  .page-header { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 2px solid var(--color-accent); }
  .page-header h1 { font-size: 36px; color: var(--color-white); margin-bottom: 8px; }
  .page-header p { color: var(--color-text-muted); font-size: 15px; }
  .stats-tabs { display: flex; gap: 8px; margin-bottom: 24px; border-bottom: 1px solid var(--color-border); overflow-x: auto; }
  .stat-tab { padding: 10px 18px; background: transparent; color: var(--color-text-muted); font-size: 13px; font-weight: 600; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
  .stat-tab:hover { color: var(--color-white); }
  .stat-tab.active { color: var(--color-white); border-bottom-color: var(--color-accent); }
  .leaders-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: none; }
  .leaders-card.active { display: block; }
  .leaders-header { padding: 18px 20px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: baseline; }
  .leaders-header h2 { color: var(--color-white); font-size: 18px; margin: 0; }
  .leaders-header .unit { color: var(--color-text-dim); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
  .leaders-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .leaders-table thead { background: var(--color-bg-elevated); }
  .leaders-table th { color: var(--color-text-dim); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 12px 16px; text-align: left; font-weight: 600; }
  .leaders-table th.num { text-align: right; }
  .leaders-table td { padding: 14px 16px; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
  .leaders-table tr:last-child td { border-bottom: none; }
  .leaders-table tr:hover { background: rgba(230, 57, 70, 0.04); }
  .leaders-table .rank { color: var(--color-accent); font-weight: 800; width: 40px; }
  .leaders-table .player { color: var(--color-white); font-weight: 600; }
  .leaders-table .pos { color: var(--color-text-dim); font-size: 12px; }
  .leaders-table .num { text-align: right; }
  .leaders-table .val { color: var(--color-white); font-weight: 700; font-size: 15px; }
  .info-note { margin-top: 20px; padding: 12px 16px; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-dim); font-size: 12px; display: flex; align-items: center; gap: 10px; }
  .info-note i { color: var(--color-accent); font-size: 16px; }
  @media (max-width: 600px) {
    .leaders-table th, .leaders-table td { padding: 10px 12px; font-size: 12px; }
    .leaders-table .pos { display: none; }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.stat-tab');
  const cards = document.querySelectorAll('.leaders-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const cat = tab.getAttribute('data-cat');
      tabs.forEach(t => t.classList.remove('active'));
      cards.forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(cat)?.classList.add('active');
    });
  });
</script>
