---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allArticles = await getCollection('articles');
const sorted = allArticles.sort((a, b) =>
  new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const categories = ['NBA', 'Rumores', 'Traspasos', 'Playoffs', 'Draft', 'Opinión'];
---

<BaseLayout title="Noticias NBA · 24 Segundos">
  <div class="container news-page">
    <div class="page-header">
      <h1>Noticias</h1>
      <p>Lo último de la NBA: análisis, rumores, traspasos y más.</p>
    </div>

    <div class="category-chips">
      <a href="/noticias" class="chip active">Todo</a>
      {categories.map(cat => (
        <a href={`/categoria/${cat.toLowerCase().replace('ó', 'o')}`} class="chip">{cat}</a>
      ))}
    </div>

    <div class="all-news-grid">
      {sorted.map(article => (
        <ArticleCard article={article} variant="default" />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .news-page { padding: 32px 0; }

  .page-header { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 2px solid var(--color-accent); }
  .page-header h1 {
    font-size: 36px;
    color: var(--color-white);
    margin-bottom: 8px;
  }
  .page-header p {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .category-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .chip {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    padding: 7px 16px;
    border-radius: 18px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s;
    text-decoration: none;
  }
  .chip:hover { border-color: var(--color-accent); color: var(--color-white); }
  .chip.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .all-news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
</style>
