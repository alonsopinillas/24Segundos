---
export interface Props {
  article: any;
  variant?: 'default' | 'large' | 'list';
}

const { article, variant = 'default' } = Astro.props;
const { title, description, category, author, date, image } = article.data;
const slug = article.slug;
const formattedDate = new Date(date).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

{variant === 'large' && (
  <article class="card-large">
    <a href={`/noticias/${slug}`}>
      <div class="card-large-img" style={image ? `background-image: url(${image})` : ''}>
        {!image && <i class="ti ti-ball-basketball"></i>}
        <span class="card-badge">{category}</span>
      </div>
      <div class="card-large-body">
        <h2>{title}</h2>
        <p>{description}</p>
        <div class="card-meta">
          <span class="author">Por {author}</span>
          <span>·</span>
          <span>{formattedDate}</span>
        </div>
      </div>
    </a>
  </article>
)}

{variant === 'default' && (
  <article class="card">
    <a href={`/noticias/${slug}`}>
      <div class="card-img" style={image ? `background-image: url(${image})` : ''}>
        {!image && <i class="ti ti-ball-basketball"></i>}
      </div>
      <div class="card-body">
        <span class="category-text">{category}</span>
        <h3>{title}</h3>
        <div class="card-meta">
          <span>{formattedDate}</span>
        </div>
      </div>
    </a>
  </article>
)}

{variant === 'list' && (
  <article class="card-list">
    <a href={`/noticias/${slug}`}>
      <div class="card-list-thumb" style={image ? `background-image: url(${image})` : ''}>
        {!image && <i class="ti ti-ball-basketball"></i>}
      </div>
      <div class="card-list-body">
        <span class="category-text">{category}</span>
        <h3>{title}</h3>
        <div class="card-meta">
          <span>{formattedDate}</span>
          <span>·</span>
          <span>Por {author}</span>
        </div>
      </div>
    </a>
  </article>
)}

<style>
  /* === Card Large (hero) === */
  .card-large {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.3s;
  }
  .card-large:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .card-large a { display: block; color: inherit; }
  .card-large-img {
    height: 360px;
    background: linear-gradient(135deg, #2a0a0d, #0a0a0a);
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 72px;
    opacity: 0.95;
  }
  .card-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--color-accent);
    color: white;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .card-large-body { padding: 24px; }
  .card-large h2 {
    font-size: 28px;
    line-height: 1.2;
    margin-bottom: 12px;
    color: var(--color-white);
  }
  .card-large p {
    color: var(--color-text-muted);
    font-size: 15px;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  /* === Default Card === */
  .card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.3s;
    height: 100%;
  }
  .card:hover { border-color: var(--color-accent); transform: translateY(-3px); }
  .card a { display: block; color: inherit; height: 100%; }
  .card-img {
    height: 160px;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 36px;
    opacity: 0.7;
  }
  .card-body { padding: 14px 16px 18px; }
  .card-body .category-text { margin-bottom: 8px; display: block; }
  .card h3 {
    font-size: 16px;
    line-height: 1.4;
    margin-bottom: 10px;
    color: var(--color-white);
  }

  /* === List Card === */
  .card-list {
    display: block;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s;
  }
  .card-list:hover { background: var(--color-bg-card); }
  .card-list a {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    color: inherit;
  }
  .card-list-thumb {
    width: 120px;
    height: 90px;
    flex-shrink: 0;
    background: var(--color-bg-elevated);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 28px;
    opacity: 0.7;
  }
  .card-list-body { flex: 1; min-width: 0; }
  .card-list-body .category-text { margin-bottom: 6px; display: block; }
  .card-list h3 {
    font-size: 17px;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  /* === Shared meta === */
  .card-meta {
    display: flex;
    gap: 10px;
    font-size: 12px;
    color: var(--color-text-dim);
    align-items: center;
    flex-wrap: wrap;
  }
  .card-meta .author { color: var(--color-text-muted); }

  @media (max-width: 768px) {
    .card-large-img { height: 220px; }
    .card-large h2 { font-size: 22px; }
    .card-large-body { padding: 18px; }
    .card-list-thumb { width: 90px; height: 70px; }
    .card-list h3 { font-size: 15px; }
  }
</style>
