---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-num">24</span>
        <span class="logo-dot"></span>
        <span class="logo-word">Segundos</span>
      </a>
      <p>El mejor sitio de noticias NBA en español. Cobertura completa, análisis y estadísticas en tiempo real.</p>
    </div>

    <div class="footer-col">
      <h4>Secciones</h4>
      <a href="/">Inicio</a>
      <a href="/noticias">Noticias</a>
      <a href="/equipos">Equipos</a>
      <a href="/estadisticas">Estadísticas</a>
    </div>

    <div class="footer-col">
      <h4>NBA</h4>
      <a href="/clasificaciones">Clasificaciones</a>
      <a href="/calendario">Calendario</a>
      <a href="/categoria/playoffs">Playoffs</a>
      <a href="/categoria/draft">Draft</a>
    </div>

    <div class="footer-col">
      <h4>Síguenos</h4>
      <a href="#" target="_blank" rel="noopener"><i class="ti ti-brand-x"></i> Twitter / X</a>
      <a href="#" target="_blank" rel="noopener"><i class="ti ti-brand-instagram"></i> Instagram</a>
      <a href="#" target="_blank" rel="noopener"><i class="ti ti-brand-youtube"></i> YouTube</a>
      <a href="/rss.xml"><i class="ti ti-rss"></i> RSS</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} 24 Segundos · Hecho con pasión por el básquetbol · Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-black);
    border-top: 1px solid var(--color-border);
    margin-top: 60px;
  }

  .footer-grid {
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
  }

  .footer-brand .logo {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 12px;
  }

  .footer-brand .logo-num {
    font-size: 24px;
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
  }

  .footer-brand .logo-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    align-self: center;
  }

  .footer-brand .logo-word {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
  }

  .footer-brand p {
    color: var(--color-text-dim);
    font-size: 13px;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-col h4 {
    color: var(--color-white);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
    font-weight: 700;
  }

  .footer-col a {
    display: block;
    color: var(--color-text-muted);
    font-size: 13px;
    padding: 4px 0;
    transition: color 0.2s;
  }

  .footer-col a:hover { color: var(--color-accent); }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 16px 0;
    color: var(--color-text-dim);
    font-size: 11px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
</style>
