            <span class="team-row">SAS</span>
            <span class="score-row lose">102</span>
          </div>
          <div class="game-row">
            <span class="team-row winner">NYK</span>
            <span class="score-row win">111</span>
          </div>
        </div>

        <div class="finals-game">
