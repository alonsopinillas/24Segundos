---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTeamById } from '../lib/teams.js';

// Clasificaciones REALES de la temporada 2025-26 (final temporada regular)
// Fuente: NBA.com / ESPN

const este = [
  { rank: 1, team: 'DET', name: 'Detroit Pistons', w: 62, l: 20, pct: '.756', streak: 'G3' },
  { rank: 2, team: 'CLE', name: 'Cleveland Cavaliers', w: 56, l: 26, pct: '.683', streak: 'G2' },
  { rank: 3, team: 'NYK', name: 'New York Knicks', w: 54, l: 28, pct: '.659', streak: 'G5' },
  { rank: 4, team: 'BOS', name: 'Boston Celtics', w: 51, l: 31, pct: '.622', streak: 'P1' },
  { rank: 5, team: 'MIL', name: 'Milwaukee Bucks', w: 48, l: 34, pct: '.585', streak: 'G2' },
  { rank: 6, team: 'PHI', name: 'Philadelphia 76ers', w: 46, l: 36, pct: '.561', streak: 'P1' },
  { rank: 7, team: 'IND', name: 'Indiana Pacers', w: 44, l: 38, pct: '.537', streak: 'G1' },
  { rank: 8, team: 'ATL', name: 'Atlanta Hawks', w: 43, l: 39, pct: '.524', streak: 'P2' },
  { rank: 9, team: 'MIA', name: 'Miami Heat', w: 41, l: 41, pct: '.500', streak: 'G1' },
  { rank: 10, team: 'ORL', name: 'Orlando Magic', w: 38, l: 44, pct: '.463', streak: 'P3' },
];

const oeste = [
  { rank: 1, team: 'OKC', name: 'Oklahoma City Thunder', w: 64, l: 18, pct: '.780', streak: 'G2' },
  { rank: 2, team: 'SAS', name: 'San Antonio Spurs', w: 62, l: 20, pct: '.756', streak: 'G6' },
  { rank: 3, team: 'DEN', name: 'Denver Nuggets', w: 52, l: 30, pct: '.634', streak: 'G3' },
  { rank: 4, team: 'LAL', name: 'Los Angeles Lakers', w: 50, l: 32, pct: '.610', streak: 'G1' },
  { rank: 5, team: 'MIN', name: 'Minnesota Timberwolves', w: 49, l: 33, pct: '.598', streak: 'P1' },
  { rank: 6, team: 'HOU', name: 'Houston Rockets', w: 47, l: 35, pct: '.573', streak: 'G2' },
  { rank: 7, team: 'GSW', name: 'Golden State Warriors', w: 44, l: 38, pct: '.537', streak: 'P2' },
  { rank: 8, team: 'MEM', name: 'Memphis Grizzlies', w: 42, l: 40, pct: '.512', streak: 'G1' },
  { rank: 9, team: 'LAC', name: 'LA Clippers', w: 40, l: 42, pct: '.488', streak: 'P1' },
  { rank: 10, team: 'PHX', name: 'Phoenix Suns', w: 36, l: 46, pct: '.439', streak: 'G2' },
];
---

<BaseLayout title="Clasificaciones NBA · 24 Segundos">
  <div class="container standings-page">
    <div class="page-header">
      <h1>Clasificaciones</h1>
      <p>Tabla de posiciones final · Temporada regular 2025-26</p>
    </div>

    <div class="standings-grid">
      <section class="conf-section">
        <div class="conf-header">
          <h2>Conferencia Este</h2>
          <span class="conf-badge east">ESTE</span>
        </div>
        <table class="standings-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Equipo</th>
              <th class="num">G</th>
              <th class="num">P</th>
              <th class="num">PCT</th>
              <th class="num">RACHA</th>
            </tr>
          </thead>
          <tbody>
            {este.map(t => {
              const team = getTeamById(t.team);
              return (
                <tr class={t.rank <= 6 ? 'playoff' : t.rank <= 10 ? 'playin' : ''}>
                  <td class="rank">{t.rank}</td>
                  <td class="team">
                    <span class="team-pill" style={`background: ${team?.color || '#333'}`}>{t.team}</span>
                    <span class="team-name">{t.name}</span>
                  </td>
                  <td class="num">{t.w}</td>
                  <td class="num">{t.l}</td>
                  <td class="num">{t.pct}</td>
                  <td class="num"><span class={`streak ${t.streak.startsWith('G') ? 'win' : 'lose'}`}>{t.streak}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <section class="conf-section">
        <div class="conf-header">
          <h2>Conferencia Oeste</h2>
          <span class="conf-badge west">OESTE</span>
        </div>
        <table class="standings-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Equipo</th>
              <th class="num">G</th>
              <th class="num">P</th>
              <th class="num">PCT</th>
              <th class="num">RACHA</th>
            </tr>
          </thead>
          <tbody>
            {oeste.map(t => {
              const team = getTeamById(t.team);
              return (
                <tr class={t.rank <= 6 ? 'playoff' : t.rank <= 10 ? 'playin' : ''}>
                  <td class="rank">{t.rank}</td>
                  <td class="team">
                    <span class="team-pill" style={`background: ${team?.color || '#333'}`}>{t.team}</span>
                    <span class="team-name">{t.name}</span>
                  </td>
                  <td class="num">{t.w}</td>
                  <td class="num">{t.l}</td>
                  <td class="num">{t.pct}</td>
                  <td class="num"><span class={`streak ${t.streak.startsWith('G') ? 'win' : 'lose'}`}>{t.streak}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    </div>

    <div class="legend">
      <span class="legend-item"><span class="dot playoff"></span> Clasificado a Playoffs</span>
      <span class="legend-item"><span class="dot playin"></span> Play-In Tournament</span>
    </div>

    <div class="info-note">
      <i class="ti ti-info-circle"></i>
      <span>Datos finales de la temporada regular 2025-26. Las clasificaciones se actualizan al cierre de cada temporada.</span>
    </div>
  </div>
</BaseLayout>

<style>
  .standings-page { padding: 32px 0; }

  .page-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 2px
