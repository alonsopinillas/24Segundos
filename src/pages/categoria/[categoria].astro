---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'nba', name: 'NBA', description: 'Toda la actualidad de la NBA al instante.' },
    { slug: 'rumores', name: 'Rumores', description: 'Los rumores más calientes del mundo NBA.' },
    { slug: 'traspasos', name: 'Traspasos', description: 'Movimientos, fichajes y operaciones de la liga.' },
    { slug: 'playoffs', name: 'Playoffs', description: 'Cobertura completa de los Playoffs NBA.' },
    { slug: 'draft', name: 'Draft', description: 'Todo sobre el Draft NBA: prospectos, mock drafts y análisis.' },
    { slug: 'opinion', name: 'Opinión', description: 'Análisis y opinión de nuestros expertos.' },
  ];

  return categories.map(cat => ({
    params: { categoria: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection('articles');

// Buscar por nombre exacto (con tilde original)
const articles = allArticles.filter(a => {
  const articleCat = a.data.category.toLowerCase().replace('ó', 'o');
  return articleCat === category.slug;
}).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title={`${category.name} · 24 Segundos`} description={category.description}>
  <div class="container category-page">
    <div class="page-header">
      <span class="cat-eyebrow">Sección</span>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
    </div>

    {articles.length > 0 ? (
      <div class="articles-grid">
        {articles.map(article => (
          <ArticleCard article={article} variant="default" />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <i class="ti ti-news-off"></i>
        <p>Todavía no hay artículos en esta categoría. ¡Pronto habrá contenido nuevo!</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-page { padding: 32px 0; }

  .page-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--color-accent);
  }

  .cat-eyebrow {
    color: var(--color-accent);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }

  .page-header h1 {
    font-size: 42px;
    color: var(--color-white);
    margin-bottom: 10px;
    letter-spacing: -1px;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 16px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--color-text-dim);
  }
  .empty-state i { font-size: 64px; margin-bottom: 16px; }
  .empty-state p { font-size: 15px; }
</style>
