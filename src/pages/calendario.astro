---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calendario NBA · 24 Segundos">
  <div class="container calendar-page">
    <div class="page-header">
      <h1>Calendario</h1>
      <p>Finales NBA 2026 · Knicks vs Spurs</p>
    </div>

    <!-- Finales NBA en curso -->
    <section class="finals-section">
      <div class="finals-header">
        <span class="finals-badge">FINALES NBA 2026</span>
        <h2>New York Knicks vs San Antonio Spurs</h2>
        <p class="finals-status">Knicks lideran la serie 3-1</p>
      </div>

      <div class="finals-games">
        <div class="finals-game">
          <span class="game-tag">Game 1 · 3 jun · San Antonio</span>
          <div class="game-row">
            <span class="team-row winner">NYK</span>
            <span class="score-row win">105</span>
          </div>
          <div class="game-row">
            <span class="team-row">SAS</span>
            <span class="score-row lose">95</span>
          </div>
        </div>

        <div class="finals-game">
          <span class="game-tag">Game 2 · 5 jun · San Antonio</span>
          <div class="game-row">
            <span class="team-row winner">NYK</span>
            <span class="score-row win">105</span>
          </div>
