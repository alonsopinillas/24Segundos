---
const navItems = [
  { name: 'Noticias', href: '/noticias' },
];

const currentPath = Astro.url.pathname;
const today = new Date().toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<div class="topbar">
  <div class="container topbar-content">
    <span class="topbar-live"><span class="live-dot"></span>NOTICIAS NBA</span>
    <span class="topbar-date">{today}</span>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <div class="header-top">
      <a href="/" class="logo" aria-label="24 Segundos - Inicio">
        <span class="logo-num">24</span>
        <span class="logo-dot"></span>
        <span class="logo-word">Segundos</span>
      </a>

      <nav class="main-nav">
        {navItems.map(item => (
          
            href={item.href}
            class={currentPath === item.href ? 'active' : ''}
          >
            {item.name}
          </a>
        ))}
      </nav>

      <div class="header-actions">
        <button class="search-btn" aria-label="Buscar">
          <i class="ti ti-search"></i>
          <span class="search-placeholder">Buscar...</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .topbar {
    background: var(--color-black);
    border-bottom: 1px solid var(--color-border);
    font-size: 11px;
    color: var(--color-text-dim);
  }
  .topbar-content {
    padding: 8px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .topbar-live {
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .topbar-date {
    text-transform: capitalize;
  }

  .site-header {
    background: var(--color-black);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
  }

  .logo:hover { color: inherit; }

  .logo-num {
    font-size: 32px;
    font-weight: 900;
    color: var(--color-accent);
    letter-spacing: -1px;
    line-height: 1;
  }

  .logo-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    align-self: center;
  }

  .logo-word {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .main-nav {
    display: flex;
    gap: 0;
    flex: 1;
    justify-content: center;
  }

  .main-nav a {
    padding: 8px 20px;
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 2px solid transparent;
  }

  .main-nav a:hover { color: var(--color-white); }
  .main-nav a.active {
    color: var(--color-white);
    border-bottom-color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-btn {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 8px 14px;
    color: var(--color-text-dim);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
    min-width: 180px;
  }

  .search-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .search-placeholder { display: none; }
    .search-btn { min-width: auto; padding: 8px 10px; }
    .logo-num { font-size: 26px; }
    .logo-word { font-size: 20px; }
    .header-top { gap: 12px; }
    .main-nav a { padding: 8px 12px; font-size: 12px; }
  }
</style>
