---
import BaseLayout from '../layouts/BaseLayout.astro';

// Datos de ejemplo de clasificación (actualizables vía JS o futuro endpoint)
const este = [
  { rank: 1, team: 'BOS', name: 'Boston Celtics', w: 56, l: 16, pct: '.778', streak: 'G4' },
  { rank: 2, team: 'NYK', name: 'New York Knicks', w: 52, l: 20, pct: '.722', streak: 'G2' },
  { rank: 3, team: 'MIL', name: 'Milwaukee Bucks', w: 49, l: 23, pct: '.681', streak: 'G1' },
  { rank: 4, team: 'CLE', name: 'Cleveland Cavaliers', w: 47, l: 25, pct: '.653', streak: 'P1' },
  { rank: 5, team: 'IND', name: 'Indiana Pacers', w: 45, l: 27, pct: '.625', streak: 'G3' },
  { rank: 6, team: 'PHI', name: 'Philadelphia 76ers', w: 42, l: 30, pct: '.583', streak: 'P2' },
  { rank: 7, team: 'MIA', name: 'Miami Heat', w: 40, l: 32, pct: '.556', streak: 'G2' },
  { rank: 8, team: 'ORL', name: 'Orlando Magic', w: 38, l: 34, pct: '.528', streak: 'P1' },
];

const oeste = [
  { rank: 1, team: 'OKC', name: 'Oklahoma City Thunder', w: 58, l: 14, pct: '.806', streak: 'G6' },
  { rank: 2, team: 'DAL', name: 'Dallas Mavericks', w: 54, l: 18, pct: '.750', streak: 'G4' },
  { rank: 3, team: 'DEN', name: 'Denver Nuggets', w: 50, l: 22, pct: '.694', streak: 'P2' },
  { rank: 4, team: 'MIN', name: 'Minnesota Timberwolves', w: 48, l: 24, pct: '.667', streak: 'G3' },
  { rank: 5, team: 'LAL', name: 'Los Angeles Lakers', w: 44, l: 28, pct: '.611', streak: 'G2' },
  { rank: 6, team: 'GSW', name: 'Golden State Warriors', w: 42, l: 30, pct: '.583', streak: 'G1' },
  { rank: 7, team: 'PHX', name: 'Phoenix Suns', w: 41, l: 31, pct: '.569', streak: 'P3' },
  { rank: 8, team: 'SAC', name: 'Sacramento Kings', w: 39, l: 33, pct: '.542', streak: 'G2' },
];

import { getTeamById } from '../lib/teams.js';
---

<BaseLayout title="Clasificaciones NBA · 24 Segundos">
  <div class="container standings-page">
    <div class="page-header">
      <h1>Clasificaciones</h1>
      <p>Tabla de posiciones actualizada de la NBA por conferencia.</p>
    </div>

    <div class="standings-grid">
      <section class="conf-section">
        <div class="conf-header">
          <h2>Conferencia Este</h2>
          <span class="conf-badge east">ESTE</span>
        </div>
        <table class="standings-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Equipo</th>
              <th class="num">G</th>
              <th class="num">P</th>
              <th class="num">PCT</th>
              <th class="num">RACHA</th>
            </tr>
          </thead>
          <tbody>
            {este.map(t => {
              const team = getTeamById(t.team);
              return (
                <tr class={t.rank <= 6 ? 'playoff' : t.rank <= 10 ? 'playin' : ''}>
                  <td class="rank">{t.rank}</td>
                  <td class="team">
                    <span class="team-pill" style={`background: ${team?.color || '#333'}`}>{t.team}</span>
                    <span class="team-name">{t.name}</span>
                  </td>
                  <td class="num">{t.w}</td>
                  <td class="num">{t.l}</td>
                  <td class="num">{t.pct}</td>
                  <td class="num"><span class={`streak ${t.streak.startsWith('G') ? 'win' : 'lose'}`}>{t.streak}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <section class="conf-section">
        <div class="conf-header">
          <h2>Conferencia Oeste</h2>
          <span class="conf-badge west">OESTE</span>
        </div>
        <table class="standings-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Equipo</th>
              <th class="num">G</th>
              <th class="num">P</th>
              <th class="num">PCT</th>
              <th class="num">RACHA</th>
            </tr>
          </thead>
          <tbody>
            {oeste.map(t => {
              const team = getTeamById(t.team);
              return (
                <tr class={t.rank <= 6 ? 'playoff' : t.rank <= 10 ? 'playin' : ''}>
                  <td class="rank">{t.rank}</td>
                  <td class="team">
                    <span class="team-pill" style={`background: ${team?.color || '#333'}`}>{t.team}</span>
                    <span class="team-name">{t.name}</span>
                  </td>
                  <td class="num">{t.w}</td>
                  <td class="num">{t.l}</td>
                  <td class="num">{t.pct}</td>
                  <td class="num"><span class={`streak ${t.streak.startsWith('G') ? 'win' : 'lose'}`}>{t.streak}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    </div>

    <div class="legend">
      <span class="legend-item"><span class="dot playoff"></span> Clasificado a Playoffs</span>
      <span class="legend-item"><span class="dot playin"></span> Play-In Tournament</span>
    </div>
  </div>
</BaseLayout>

<style>
  .standings-page { padding: 32px 0; }

  .page-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--color-accent);
  }
  .page-header h1 { font-size: 36px; color: var(--color-white); margin-bottom: 8px; }
  .page-header p { color: var(--color-text-muted); font-size: 15px; }

  .standings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 20px;
  }

  .conf-section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .conf-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conf-header h2 {
    color: var(--color-white);
    font-size: 18px;
    margin: 0;
  }

  .conf-badge {
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    color: white;
    letter-spacing: 1px;
  }
  .conf-badge.east { background: #1d428a; }
  .conf-badge.west { background: #c8102e; }

  .standings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .standings-table thead { background: var(--color-bg-elevated); }
  .standings-table th {
    color: var(--color-text-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 10px 12px;
    text-align: left;
    font-weight: 600;
  }
  .standings-table th.num { text-align: right; }

  .standings-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .standings-table tr:last-child td { border-bottom: none; }
  .standings-table tr.playoff { background: rgba(76, 175, 80, 0.03); }
  .standings-table tr.playin { background: rgba(255, 193, 7, 0.03); }
  .standings-table tr:hover { background: rgba(230, 57, 70, 0.05); }

  .standings-table .rank {
    color: var(--color-accent);
    font-weight: 800;
    width: 32px;
  }

  .standings-table .team {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .team-pill {
    display: inline-block;
    padding: 3px 6px;
    border-radius: 4px;
    color: white;
    font-size: 10px;
    font-weight: 700;
    min-width: 32px;
    text-align: center;
  }

  .team-name {
    color: var(--color-white);
    font-weight: 500;
    font-size: 13px;
  }

  .standings-table .num { text-align: right; font-weight: 600; }

  .streak {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
  }
  .streak.win { background: rgba(76, 175, 80, 0.15); color: #6cc070; }
  .streak.lose { background: rgba(230, 57, 70, 0.15); color: #e63946; }

  .legend {
    display: flex;
    gap: 20px;
    color: var(--color-text-dim);
    font-size: 12px;
    padding: 12px 0;
  }
  .legend-item { display: flex; align-items: center; gap: 6px; }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot.playoff { background: rgba(76, 175, 80, 0.5); }
  .dot.playin { background: rgba(255, 193, 7, 0.5); }

  @media (max-width: 968px) {
    .standings-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .team-name { display: none; }
  }
</style>
