---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calendario NBA · 24 Segundos">
  <div class="container calendar-page">
    <div class="page-header">
      <h1>Calendario</h1>
      <p>Resultados recientes y próximos partidos.</p>
    </div>

    <!-- Finales NBA en curso - destacado manual -->
